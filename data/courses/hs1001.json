 "syllabus": {
  "description_paragraphs": [
   "This course aims to develop fluency and confidence in both spoken and written English, drawing on insights from learning theories and established language-teaching methods.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Rajesh Kumar, Department of Humanities and Social Sciences, IIT Madras",
   "Prof. Shreesh Chaudhary, Department of Humanities and Social Sciences, IIT Madras",
   "Prof. Om Prakash, Department of Humanities and Social Sciences, Gautham Buddha University, Noida",
   "Ms. Karthika Sathyanathan, Department of Humanities and Social Sciences, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Sounds and words; Vowel and consonant sounds articulation; Diphthongs, semi-vowels, consonant clusters."
   },
   {
    "label": "Week 2",
    "text": "Parts of speech - nouns, pronouns, verbs, adjectives, adverbs; Prepositions, conjunctions, interjections; Articles."
   },
   {
    "label": "Week 3",
    "text": "Vocabulary; Phrasal verbs; Modal verbs; Phrases and idioms."
   },
   {
    "label": "Week 4",
    "text": "Spoken English basics; Speaking pace and pauses; Structuring speech; Presentations; Telephone English."
   },
   {
    "label": "Week 5",
    "text": "Tenses (past, present, and future); Subject-verb agreement and practice."
   },
   {
    "label": "Week 6",
    "text": "Reading skills - skimming, scanning, SQ3R, PQRST; Short and long texts; Critical reading; Test preparation."
   },
   {
    "label": "Week 7",
    "text": "Listening skills - active vs passive, barriers; Technical talks; Practice and test preparation."
   },
   {
    "label": "Week 8",
    "text": "Aspiration, word stress, syllables and syllabification; Plurality."
   },
   {
    "label": "Week 9",
    "text": "Speaking skills - presentations and slides; Group discussions (rules); Storytelling; Speaking test preparation."
   },
   {
    "label": "Week 10",
    "text": "Grammar and common errors; Writing basics - describing visuals; Public writing."
   },
   {
    "label": "Week 11",
    "text": "Writing - notes, business writing, instructions; Data interpretation; Essays; Clarity and simplicity."
   },
   {
    "label": "Week 12",
    "text": "Professional writing - paragraphs, formality and tone; Editing."
   }
  ],
  "weeks_note": ""
 },
