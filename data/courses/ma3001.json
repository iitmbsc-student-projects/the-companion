 "syllabus": {
  "description_paragraphs": [
   "This course introduces the mathematical foundations of Computer Science and Data Science, including sets, functions, sequences, logic, proofs, induction, recursion, combinatorics, relations, graph theory, and algebraic structures. This course shall develop the ability to model computational problems, reason rigorously, analyze discrete structures, and apply mathematical techniques to algorithms, data analysis, and real-world computing challenges.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Meenakshi D'Souza, Department of Computer Science and Engineering, IIIT Bangalore"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Foundations of discrete mathematics; sets, set operations, functions, recursive functions, sequences, and summation techniques."
   },
   {
    "label": "Week 12",
    "text": "Graph theory and algebraic structures; graphs, trees, semigroups, monoids, groups, homomorphisms, normal subgroups, and congruence relations."
   }
  ],
  "weeks_note": ""
 },
