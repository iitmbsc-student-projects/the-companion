 "syllabus": {
  "description_paragraphs": [
   "This course provides a comprehensive introduction to databases and PostgreSQL, covering database management and design, along with key topics such as security, integrity, and concurrency.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Partha Pratim Das, Department of Computer Science and Engineering, IIT Kharagpur"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to DBMS; Motivation and need for DBMS."
   },
   {
    "label": "Week 2",
    "text": "Relational model; Introduction to SQL."
   },
   {
    "label": "Week 3",
    "text": "SQL examples; Intermediate SQL; Advanced SQL."
   },
   {
    "label": "Week 4",
    "text": "Formal relational query languages; Entity - Relationship (ER) model and database design."
   },
   {
    "label": "Week 5",
    "text": "Database design - functional dependencies, keys, closure, canonical cover; Lossless join and dependency preservation."
   },
   {
    "label": "Week 6",
    "text": "Normal forms; Multivalued dependencies and 4NF; Database design case studies; Temporal data; Problem solving on normalization."
   },
   {
    "label": "Week 7",
    "text": "Application architecture; Web applications; SQL integration with programming languages; Python with PostgreSQL."
   },
   {
    "label": "Week 8",
    "text": "Algorithms and complexity; Data structures; Storage and file structures."
   },
   {
    "label": "Week 9",
    "text": "Indexing techniques; Hashing; Index design; B-trees and B+ trees."
   },
   {
    "label": "Week 10",
    "text": "Transactions - serializability, recoverability; Concurrency control."
   },
   {
    "label": "Week 11",
    "text": "Backup techniques; Recovery mechanisms; RAID and fault tolerance."
   },
   {
    "label": "Week 12",
    "text": "Query processing and optimization; RDBMS architecture; NoSQL; DBMS overview and summary."
   }
  ],
  "weeks_note": ""
 },
