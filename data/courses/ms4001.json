 "syllabus": {
  "description_paragraphs": [
   "This course introduces the key aspects of Industry 4.0, connects its challenges to relevant data science techniques, and develops tools and data-driven business models for real-world applications.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Rahul Marathe, Department of Management Studies, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Industry 4.0 foundations; Evolution of industrial revolutions; Concepts and examples of modern industrial systems."
   },
   {
    "label": "Week 2",
    "text": "Facility layout design; Types of layouts (process, product, fixed-position); Layout optimization."
   },
   {
    "label": "Week 3",
    "text": "Facility location problems; Single and multi-facility models; Optimization approaches (median problems)."
   },
   {
    "label": "Week 4",
    "text": "Sourcing decisions; Supplier segmentation; Association rule mining (Apriori algorithm)."
   },
   {
    "label": "Week 5",
    "text": "Inventory management fundamentals; EOQ and newsvendor models; Dynamic inventory (Bellman equations)."
   },
   {
    "label": "Week 6",
    "text": "Stochastic inventory models; Value and policy iteration; Dynamic decision-making."
   },
   {
    "label": "Week 7",
    "text": "Inventory management in supply networks; Material flow; Multi-stage and omni-channel systems."
   },
   {
    "label": "Week 8",
    "text": "Industry 4.0 technologies; IoT; Time series forecasting; Predictive maintenance."
   },
   {
    "label": "Week 9",
    "text": "Logistics and distribution management; Transportation models; TSP and vehicle routing problems."
   },
   {
    "label": "Week 10",
    "text": "Digital transformation; Industry 4.0 in manufacturing; Simulation, ERP , and digital twins."
   },
   {
    "label": "Week 11",
    "text": "Pricing strategies; Capacity allocation; Revenue management (Littlewood's rule)."
   },
   {
    "label": "Week 12",
    "text": "AI applications in manufacturing; Intelligent and automated production systems."
   }
  ],
  "weeks_note": ""
 },
