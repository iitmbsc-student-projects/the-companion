 "syllabus": {
  "description_paragraphs": [
   "This course introduces the fundamental concepts of linear algebra, calculus, and optimization with an emphasis on their applications in machine learning and data science.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Sarang S Sane, Department of Mathematics, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Vectors and matrices; Systems of linear equations; Determinants (Part 1 and 2)."
   },
   {
    "label": "Week 2",
    "text": "Solving linear equations - determinants (Part 3), Cramer's rule, invertible coefficient matrices; Echelon form, row reduction, Gaussian elimination."
   },
   {
    "label": "Week 3",
    "text": "Vector spaces - introduction, properties; Linear dependence and independence."
   },
   {
    "label": "Week 4",
    "text": "Basis and dimension - definition, computation of bases; Rank and dimension via Gaussian elimination."
   },
   {
    "label": "Week 5",
    "text": "Rank and nullity of a matrix; Linear transformations - null space (basis and nullity); Linear mappings and transformations."
   },
   {
    "label": "Week 6",
    "text": "Linear transformation - matrix representations with ordered bases; Image and kernel; Computation of bases for image and kernel."
   },
   {
    "label": "Week 7",
    "text": "Equivalent and similar matrices; Affine subspaces and mappings; Inner products, norms, lengths, and angles."
   },
   {
    "label": "Week 8",
    "text": "Orthogonality and orthonormality; Projections; Gram-Schmidt method; Orthogonal transformations and rotations."
   },
   {
    "label": "Week 9",
    "text": "Multivariate functions - visualisation; Partial and directorial derivatives; Limits and continuity; Gradient interpretation."
   },
   {
    "label": "Week 10",
    "text": "Optimization concepts - steepest ascent/descent: Tangent lines and tangent hyperplanes; Critical points."
   },
   {
    "label": "Week 11",
    "text": "Higher-order partial derivatives; Hessian Matrix; Local extrema in two and three variables; Differentiability of multivariable functions; Review of 'Mathematics for Data Science II'."
   }
  ],
  "weeks_note": ""
 },
