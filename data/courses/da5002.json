 "syllabus": {
  "description_paragraphs": [
   "This course explores deep generative models, covering their probabilistic foundations and learning algorithms. It includes models such as variational autoencoders, generative adversarial networks, autoregressive models, diffusion models, and large language models, along with their implementation using frameworks like PyTorch. Students gain both theoretical understanding and hands-on experience through lectures and assignments across diverse AI tasks. This course is also offered as an elective for Degree level students.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Prathosh A P , Department of Electrical Communication Engineering, IISC Bengaluru"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to deep generative models; Generative AI fundamentals; Variational divergence minimization; PyTorch basics (tensors, datasets, model building)."
   },
   {
    "label": "Week 2",
    "text": "Variational approaches to generative modeling; Introduction to GANs; GAN formulation and basic implementation."
   },
   {
    "label": "Week 3",
    "text": "Advanced GANs; DCGAN and conditional GANs; GANs as guided samplers; Practical implementations."
   },
   {
    "label": "Week 4",
    "text": "GAN training challenges; Wasserstein GANs; BiGANs and inversion techniques; Domain adversarial learning; Evaluation of generative models."
   },
   {
    "label": "Week 5",
    "text": "Latent variable models; ELBO; Gaussian Mixture Models and EM algorithm; Variational Autoencoders (VAEs)."
   },
   {
    "label": "Week 6",
    "text": "Training VAEs; Reparameterization trick; Inference; Variants (β-VAE, VQ-VAE); Implementations."
   },
   {
    "label": "Week 7",
    "text": "Diffusion models; Denoising Diffusion Probabilistic Models (DDPMs); U-Net architectures."
   },
   {
    "label": "Week 8",
    "text": "DDPM theory; ELBO derivation and optimization; Training and inference; Implementation and proofs."
   },
   {
    "label": "Week 9",
    "text": "Advanced diffusion models; Score-based interpretation; Guided diffusion; Latent diffusion; DDIMs and inference methods."
   },
   {
    "label": "Week 10",
    "text": "Autoregressive models; Attention mechanisms; Transformer architecture; Training and inference."
   },
   {
    "label": "Week 11",
    "text": "Reinforcement learning basics; Policy gradient methods; PPO and TRPO; RL for generative models."
   },
   {
    "label": "Week 12",
    "text": "Alignment and preference learning; Reward modeling; Direct Preference Optimization (DPO); State-space models."
   }
  ],
  "weeks_note": ""
 },
