 "syllabus": {
  "description_paragraphs": [
   "This course introduces computational methods used in statistical estimation and learning problems",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Dootika Vats, Assistant Professor, Department of Mathematics and Statistics, IIT Kanpur"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Random number generation; Congruential methods; Discrete sampling (inverse transform, accept-reject); Generating Bernoulli, Poisson, binomial, and geometric variables."
   },
   {
    "label": "Week 2",
    "text": "Sampling techniques; Composition method; Inverse transform for continuous distributions; Visualization in R."
   },
   {
    "label": "Week 3",
    "text": "Advanced sampling methods; Accept-reject optimization; Box-Muller method for Gaussian variables; Proposal selection strategies."
   },
   {
    "label": "Week 4",
    "text": "Ratio-of-uniforms method; Multivariate and mixture sampling; Specialized distributions (beta, Dirichlet); Multidimensional sampling."
   },
   {
    "label": "Week 5",
    "text": "Monte Carlo methods; Importance sampling; Variance reduction; Optimal proposal distributions; R-based implementations."
   },
   {
    "label": "Week 6",
    "text": "Weighted importance sampling; Likelihood functions; Maximum likelihood estimation (MLE); Linear regression via MLE."
   },
   {
    "label": "Week 7",
    "text": "Penalized regression; Ridge regression; Likelihood visualization; Taylor series approximations; Simulation in R."
   },
   {
    "label": "Week 8",
    "text": "Numerical optimization; Newton-Raphson methods (univariate and multivariate); Logistic regression via MLE; Convergence behavior."
   },
   {
    "label": "Week 9",
    "text": "Gradient-based optimization; Gradient ascent; MM (Majorize-Minimize) algorithms; Applications in regression and estimation."
   },
   {
    "label": "Week 10",
    "text": "Expectation-Maximization (EM) algorithm; Gaussian mixture models; Multivariate clustering; Handling missing/censored data."
   },
   {
    "label": "Week 11",
    "text": "Model evaluation and selection; Cross-validation; Bootstrapping; Resampling methods; Choosing hyperparameters and model complexity."
   },
   {
    "label": "Week 12",
    "text": "Applications of SGD with code. Simulated annealing: examples, codes, and challenges"
   }
  ],
  "weeks_note": ""
 },
