 "kind": "project",
 "title": "MAD I Project",
 "program": "Diploma / Programming",
 "credits": 2,
 "standfirst": "A small end-to-end web application, submitted and defended, that puts the MAD I ideas into practice.",
 "instructor": "Prof. Nitin Chandrachoodan &amp; Mr. Thejesh GN",
 "term": "Every term",
 "prereq": "CS2003",
 "syllabus_body_html": "<p>This Project provides hands-on experience in building end-to-end web applications using technologies such as HTML, CSS, JavaScript, Flask, APIs, and SQLite. It focuses on developing secure, efficient, and deployable applications while applying core web development concepts.</p>\n      <p><b>Co-requisite:</b> BSCS2003:  Modern Application Development I</p>\n      <p><b>Faculty:</b></p>\n      <ul class=\"link-list\">\n          <li>Prof. Nitin Chandrachoodan, Department of Electrical Engineering, IIT Madras</li><li>Mr. Thejesh GN, Independent Technologist, Multiple Affiliations</li>\n      </ul>\n      <p><b>How the project runs:</b></p>\n      <ul class=\"link-list\">\n          <li>The objective of this project is to provide hands-on experience in developing a web application from scratch by integrating technologies covered in the course.</li><li>Students apply their knowledge to build a functional web application incorporating secure authentication, efficient data management, and API integration.</li><li>The project reinforces key concepts, enhances problem-solving skills, and improves proficiency in web application development.</li><li>The viva consists of two levels, with the final round conducted by industry experts and contributing significantly to the final grade.</li>\n      </ul>\n      <p><a href=\"https://study.iitm.ac.in/ds/course_pages/BSCS2003P.html\" target=\"_blank\" rel=\"noopener\">Official syllabus on the IITM study portal →</a></p>\n    <ul class=\"link-list\" style=\"margin-top:14px\"><li><a href=\"https://thejeshgn.com/projects/modern-application-development-1/\" target=\"_blank\" rel=\"noopener\">Screencasts by Thejesh GN</a></li></ul>",
 "milestones_html": "<p class=\"placeholder\">Milestone dates and submission deadlines not yet added.</p>",
