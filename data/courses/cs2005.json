 "syllabus": {
  "description_paragraphs": [
   "This course uses Java to develop an understanding of core concepts such as object-oriented programming, exception handling, event-driven programming, concurrent programming, and functional programming.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Madhavan Mukund, Director, Chennai Mathematical Institute"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Orientation; Java basics - types, memory; OOP - abstraction, classes and objects."
   },
   {
    "label": "Week 2",
    "text": "Java basics; Data types; Control flow; Classes and objects; Input and output."
   },
   {
    "label": "Week 3",
    "text": "OOP - inheritance, polymorphism; Class hierarchy; Subtyping; Modifiers."
   },
   {
    "label": "Week 4",
    "text": "Abstract classes and interfaces; Encapsulation and controlled interaction; Private classes; Callbacks; Iterators."
   },
   {
    "label": "Week 5",
    "text": "Polymorphism; Generic programming; Generics and subtyping; Runtime behavior of generics."
   },
   {
    "label": "Week 6",
    "text": "Indirection and abstraction; Collections - abstraction, concrete collections, maps."
   },
   {
    "label": "Week 7",
    "text": "Error handling - exceptions, assertions; Packages; Logging."
   },
   {
    "label": "Week 8",
    "text": "Cloning; Type inference; Functional programming (higher-order functions, streams)."
   },
   {
    "label": "Week 9",
    "text": "Optional types; Stream processing and result collection; Input/output streams; Serialization."
   },
   {
    "label": "Week 10",
    "text": "Concurrency - threads, race conditions; Synchronisation (mutual exclusion, test-and-set, monitors)."
   },
   {
    "label": "Week 11",
    "text": "Concurrency in Java - threads and monitors; Concurrent programming examples; Thread-safe collections."
   },
   {
    "label": "Week 12",
    "text": "Graphical user interfaces; Event-driven programming; Swing toolkit; GUI examples."
   }
  ],
  "weeks_note": ""
 },
