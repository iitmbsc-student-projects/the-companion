 "syllabus": {
  "description_paragraphs": [
   "A significant share of data and problem statements in data science arises from the business domain. This course provides a foundational understanding of how businesses are structured and operate from a data perspective.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. G Venkatesh, Director, School of Technology, Dhirubhai Ambani University",
   "Dr. Milind Gandhe, Machine Intelligence and Robotics (MINRO) COE, IIIT Bangalore"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to economics - economic flow, demand and supply; Spreadsheets; Spreadsheet functions; Economics applications using Excel."
   },
   {
    "label": "Week 2",
    "text": "External data sources and survey methods; Exploring demographic data; Analysing demographic data."
   },
   {
    "label": "Week 3",
    "text": "Market size estimation."
   },
   {
    "label": "Week 4",
    "text": "Pivot tables; Data visualisation; Market share and aspirational data analysis."
   },
   {
    "label": "Week 5",
    "text": "E-commerce - case study and data analysis; Key questions and data review; Pareto analysis (volume and revenue); Scatter plots; Trend analysis."
   },
   {
    "label": "Week 6",
    "text": "Sales and trend analysis; Inventory and ledger metrics; VLOOKUP and pivot tables; Key learnings."
   },
   {
    "label": "Week 7",
    "text": "Manufacturing case study - data (sales, production, inventory); Revenue and portfolio analysis; Regional planning."
   },
   {
    "label": "Week 8",
    "text": "Production and inventory analytics - scheduling, scrap, OEE; Profitability and margins; Safety stock and reordering."
   },
   {
    "label": "Week 9",
    "text": "HR and recruitment - sourcing, selection, ranking; Channel effectiveness; Diversity analysis; Onboarding."
   },
   {
    "label": "Week 10",
    "text": "Fintech and payments; Credit case study; Nudge economics; Data and segment analysis; Behavioral insights."
   },
   {
    "label": "Week 11",
    "text": "A/B testing; Credit risk analysis; Dataset exploration and review; Monthly trend analysis."
   },
   {
    "label": "Week 12",
    "text": "Business operations and management; Spreadsheet-based data processing."
   }
  ],
  "weeks_note": ""
 },
