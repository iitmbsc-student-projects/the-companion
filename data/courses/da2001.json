 "syllabus": {
  "description_paragraphs": [
   "This course introduces the foundations and practical aspects of Deep Learning and Generative AI, combining theory with hands-on experience. It covers neural network models for computer vision and natural language processing, including CNNs, RNNs, LSTMs, and generative models such as autoencoders, VAEs, GANs, and large language models.",
   "<b>Co-requisite:</b> CS2008 : Machine Learning Practice",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Balaji Srinivasan, Wadhwani School of Data Science, IIT Madras",
   "Prof. Ganapathy, Wadhwani School of Data Science, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to Deep Learning; Artificial neurons, neural networks, layers; Activation functions and loss metrics."
   },
   {
    "label": "Week 2",
    "text": "Building simple neural networks using TensorFlow/Keras, Experimentation with activation functions and optimization methods."
   },
   {
    "label": "Week 3",
    "text": "Introduction to Convolutional Neural Networks (CNNs), CNN architecture basics, convolution and pooling layers."
   },
   {
    "label": "Week 4",
    "text": "Modelling Vision - CNN; CNN-based image classification (e.g., MNIST, CIFAR-10)."
   },
   {
    "label": "Week 5",
    "text": "Modelling Sequential Data  - sequence models; Recurrent Neural Networks (RNNs), LSTMs."
   },
   {
    "label": "Week 6",
    "text": "Sentiment analysis with LSTM; Text generation with simple RNN/LSTM models; Time series prediction tasks."
   },
   {
    "label": "Week 7",
    "text": "Introduction to Generative AI, Autoencoders and Variational Autoencoders (VAEs) basics, GANs."
   },
   {
    "label": "Week 8",
    "text": "Diffusion Probabilistic models, training and inference."
   },
   {
    "label": "Week 9",
    "text": "GANs and Pretrained Diffusion Models to generate images"
   },
   {
    "label": "Week 10",
    "text": "Large Language Models - Transformer Architecture; Word Embeddings, Tokenization and attention."
   },
   {
    "label": "Week 11",
    "text": "BERT like models for NLP tasks; Decoders for Text Generation; Machine Translation; Fine-tuning LLMs (PEFT, LoRA )"
   },
   {
    "label": "Week 12",
    "text": "Prompting Techniques, prompt fine-tuning and other methods"
   }
  ],
  "weeks_note": ""
 },
