 "syllabus": {
  "description_paragraphs": [
   "Operating systems interface between hardware and applications, enabling efficient resource management without direct hardware handling. This introductory course, intended for students with prior knowledge of computer organization, explores these concepts using the xv6 operating system, similar to Linux.",
   "<b>Pre-requisite:</b> BSCS3031 : Computer Systems Design",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Chester Rebeiro, Department of Computer Science and Engineering, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to operating systems; OS concepts and structure; System organization fundamentals."
   },
   {
    "label": "Week 2",
    "text": "System booting and xv6 on QEMU; Virtual memory and demand paging; Page translation and page tables."
   },
   {
    "label": "Week 3",
    "text": "Memory management in xv6; Process abstraction; Process control blocks; System calls and trap handling."
   },
   {
    "label": "Week 4",
    "text": "Process management (fork, exec, exit, wait); Process trees; Kernel-to-user transitions in xv6."
   },
   {
    "label": "Week 5",
    "text": "Executable formats (ELF); Exec system call; Program loading and execution in xv6."
   },
   {
    "label": "Week 6",
    "text": "Interrupts and exceptions; Hardware and timer interrupts; Context switching."
   },
   {
    "label": "Week 7",
    "text": "Scheduling"
   },
   {
    "label": "Week 8",
    "text": "Synchronization"
   },
   {
    "label": "Week 9",
    "text": "Deadlocks and Threads"
   },
   {
    "label": "Week 10",
    "text": "Storage and file systems; Disk access and scheduling; File system organization and implementation."
   },
   {
    "label": "Week 11",
    "text": "File system internals (xv6); System crashes and recovery; OS security and access control mechanisms."
   },
   {
    "label": "Week 12",
    "text": "System vulnerabilities and attacks; Micro-architectural attacks; Countermeasures; Trusted execution and secure storage."
   }
  ],
  "weeks_note": ""
 },
