 "syllabus": {
  "description_paragraphs": [
   "This course introduces the practical aspects of large-scale analytics (big data), beginning with foundational concepts in big data and cloud computing across hardware, systems, and software, and progressing to algorithm design and execution at scale.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Dr. Rangarajan Vasudevan, Co-Founder &amp; Chief Data Officer, Lentre.ai"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Big data fundamentals; Cloud and Spark; MapReduce concepts; Sorting and hashing."
   },
   {
    "label": "Week 2",
    "text": "Cloud fundamentals; Cloud-native architecture; Cloud services; Big data in cloud."
   },
   {
    "label": "Week 3",
    "text": "Data pipelines; Data formats; Relational vs non-relational data; Data lakes and warehouses; Data extraction."
   },
   {
    "label": "Week 4",
    "text": "Hadoop and Spark; Spark architecture; Spark SQL and streaming; Hands-on data processing."
   },
   {
    "label": "Week 5",
    "text": "ETL/ELT; Data processing patterns; Metadata and lifecycle; Scheduling."
   },
   {
    "label": "Week 6",
    "text": "SQL and relational algebra; Query planning and optimization; Join algorithms; Spark SQL optimization; NoSQL databases."
   },
   {
    "label": "Week 7",
    "text": "Streaming vs batch; Streaming fundamentals; Pub/Sub; Dataflow and Beam."
   },
   {
    "label": "Week 8",
    "text": "Kafka architecture; Message semantics; Exactly-once processing; Spark streaming; Windowing and real-time processing."
   },
   {
    "label": "Week 9",
    "text": "Big data ML; Distributed ML; Spark MLlib; MLOps; Best practices."
   },
   {
    "label": "Week 10",
    "text": "Deep learning on big data; Distributed training; Streaming inference; Course recap."
   },
   {
    "label": "Week 11",
    "text": "Prep week for final project; Summarizing key concepts."
   }
  ],
  "weeks_note": ""
 },
