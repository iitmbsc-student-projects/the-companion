 "syllabus": {
  "description_paragraphs": [
   "Building a modern application involves multiple components, including the front end, transaction handling, data storage, server communication, and API integration. The courses Modern Application Development I, and II address these aspects through a detailed, evolving case study, introducing relevant programming skills as the course progresses.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Nitin Chandrachoodan, Department of Electrical Engineering, IIT Madras",
   "Mr. Thejesh GN, Independent Technologist, Multiple Affiliations"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Applications and architectures; Web fundamentals and protocols; Web servers and performance; Replit development."
   },
   {
    "label": "Week 2",
    "text": "Information representation; HTML and CSS (styling, selectors, responsive design); Bootstrap."
   },
   {
    "label": "Week 3",
    "text": "MVC and views; UI/UX design and usability; Tools and accessibility; Jinja2 and command-line usage."
   },
   {
    "label": "Week 4",
    "text": "Persistent storage and relational databases; ER diagrams; SQL; Flask."
   },
   {
    "label": "Week 5",
    "text": "Requests and responses; CRUD; Routes and controllers; Database integration (SQLite, SQLAlchemy); Flask structure."
   },
   {
    "label": "Week 6",
    "text": "API design and REST; OpenAPI and documentation; Flask-RESTful."
   },
   {
    "label": "Week 7",
    "text": "Memory hierarchy; Data and database search; SQL vs NoSQL; Scaling; Database security; Logging and debugging."
   },
   {
    "label": "Week 8",
    "text": "Frontend development; Asynchronous updates; Client-side operations and security; Indexing and full-text search."
   },
   {
    "label": "Week 9",
    "text": "Access control; Security mechanisms; Sessions; HTTPS; Logging; Introduction to JavaScript."
   },
   {
    "label": "Week 10",
    "text": "Application testing; Levels of testing; Test generation; Pytest; Flask-Security; Testing practices."
   },
   {
    "label": "Week 11",
    "text": "Advanced frontend - JavaScript, custom elements, frameworks; DB migration."
   },
   {
    "label": "Week 12",
    "text": "Application architecture; Services; Deployment and containers."
   }
  ],
  "weeks_note": ""
 },
