 "syllabus": {
  "description_paragraphs": [
   "This course introduces command-line usage and progresses to automating complex tasks in a Linux environment. With tools like WSL on Windows and bash on macOS, these concepts are widely applicable. Students learn to combine commands, use I/O redirection, and write shell scripts to solve complex problems efficiently - often without needing specialized programs or graphical interfaces. By the end, they will appreciate the power, brevity, and efficiency of the command line, while gaining deeper insight into how their systems work.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 3-0-0-3"
  ],
  "faculty": [
   "Prof. Gandham Phanikumar, Department of Metallurgical and Materials Engineering, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Linux virtual machine setup; Command-line environment; Basic Linux commands."
   },
   {
    "label": "Week 2",
    "text": "Linux commands (advanced); Shell variables; Process management."
   },
   {
    "label": "Week 3",
    "text": "Combining commands and file handling; Input/output redirection; Software management."
   },
   {
    "label": "Week 4",
    "text": "Redirection and pipes; Regex (egrep); File search (find); Editors; Bash scripting."
   },
   {
    "label": "Week 5",
    "text": "Shell scripting - variables, arguments; Conditionals, loops, functions; Scheduled tasks."
   },
   {
    "label": "Week 6",
    "text": "AWK - text processing, data analysis; Regular expressions in AWK; AWK as a programming language; Introduction to sed; Pattern matching and substitution using regex."
   },
   {
    "label": "Week 7",
    "text": "Build tools (make); File compression; Networking (IP , ports, DNS); Diagnostics; Log analysis."
   },
   {
    "label": "Week 8",
    "text": "RAID; Git - workflow, branches, pull requests; Collaboration and issue management."
   }
  ],
  "weeks_note": ""
 },
