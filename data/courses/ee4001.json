 "syllabus": {
  "description_paragraphs": [
   "This course introduces the fundamentals of speech and speech technologies, their real-world applications, and provides hands-on experience with relevant speech processing toolkits. This course is also offered as an elective for PG-diploma students.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. S. Umesh, Department of Electrical Engineering, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to speech and signal processing; fundamentals of sampling, Fourier analysis, and speech production and perception."
   },
   {
    "label": "Week 2",
    "text": "Speech analysis techniques; perceptual features, filtering, and feature extraction including MFCCs."
   },
   {
    "label": "Week 3",
    "text": "Statistical modeling for speech; Gaussian models, classification, and mixture models."
   },
   {
    "label": "Week 4",
    "text": "Vector quantization and sequence modeling; Markov chains and the Viterbi algorithm."
   },
   {
    "label": "Week 5",
    "text": "Hidden Markov Models (HMMs); sequence inference and probabilistic modeling."
   },
   {
    "label": "Week 6",
    "text": "Speech recognition systems; feature extraction and HMM-GMM based approaches."
   },
   {
    "label": "Week 7",
    "text": "Language modeling and introduction to neural networks; n-grams and deep learning basics."
   },
   {
    "label": "Week 8",
    "text": "Feedforward neural networks and training; backpropagation and introduction to CTC."
   },
   {
    "label": "Week 9",
    "text": "Recurrent neural networks and sequence modeling; applications and limitations."
   },
   {
    "label": "Week 10",
    "text": "Advanced neural architectures; word embeddings, sequence-to-sequence models, and convolutional neural networks."
   },
   {
    "label": "Week 11",
    "text": "Transformers and modern deep learning approaches; self-attention and self-supervised learning."
   },
   {
    "label": "Week 12",
    "text": "Speech synthesis and speaker recognition; end-to-end systems, verification, and diarization."
   }
  ],
  "weeks_note": ""
 },
