 "syllabus": {
  "description_paragraphs": [
   "Building a modern application involves multiple components, including the front end, transaction handling, data storage, server communication, and API integration. The courses Modern Application Development I, and II address these aspects through a detailed, evolving case study, introducing relevant programming skills as the course progresses.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Nitin Chandrachoodan, Department of Electrical Engineering, IIT Madras",
   "Mr. Thejesh GN, Independent Technologist, Multiple Affiliations"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "JavaScript fundamentals - syntax, variables, control flow and functions; DOM API."
   },
   {
    "label": "Week 2",
    "text": "JavaScript - collections, iteration, modularity; Prototypes and classes; Asynchrony; JSON and APIs."
   },
   {
    "label": "Week 3",
    "text": "Frontend implementation; Introduction to Vue.js."
   },
   {
    "label": "Week 4",
    "text": "Introduction to Vue.js and its components."
   },
   {
    "label": "Week 5",
    "text": "Using APIs; Vue.js lifecycle; Asynchronous JavaScript (async/await); Fetch API; API calls in Vue.js."
   },
   {
    "label": "Week 6",
    "text": "Persistent storage; Vue.js - validation, components, testing, routing."
   },
   {
    "label": "Week 7",
    "text": "Advanced state management; Vuex; Routing in Vue.js; Single-page applications (SPAs); Single-file components."
   },
   {
    "label": "Week 8",
    "text": "API design and GraphQL; JAM approach; Authentication; Vue-Flask integration."
   },
   {
    "label": "Week 9",
    "text": "Web servers; Message queues; Asynchronous tasks with Celery; Redis; Celery integration with Flask."
   },
   {
    "label": "Week 10",
    "text": "Messaging - webhooks, push to client; Server-sent events."
   },
   {
    "label": "Week 11",
    "text": "Performance measurement and caching."
   },
   {
    "label": "Week 12",
    "text": "Security - privacy, frontend, backend; CORS and cookies."
   }
  ],
  "weeks_note": ""
 },
