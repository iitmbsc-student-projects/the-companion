 "syllabus": {
  "description_paragraphs": [
   "This course introduces the primary methods and models used in regression, classification, and clustering, and examines their properties to understand their suitability for different problem settings.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Arun Rajkumar, Wadhwani School of Data Science, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Machine Learning - learning paradigms; Representation learning; PCA."
   },
   {
    "label": "Week 2",
    "text": "Unsupervised Learning - PCA limitations and complexity; Feature transformation; Kernel methods."
   },
   {
    "label": "Week 3",
    "text": "Clustering - K-means algorithm; Convergence and cluster properties; Initialization methods (K-means++); Choosing number of clusters."
   },
   {
    "label": "Week 4",
    "text": "Estimation - MLE, Bayesian; GMM and likelihood; Convexity and Jensen's inequality; EM algorithm."
   },
   {
    "label": "Week 5",
    "text": "Supervised Learning - linear regression; Optimization (gradient descent); Kernel and probabilistic regression."
   },
   {
    "label": "Week 6",
    "text": "Linear regression - evaluation, cross-validation; Bayesian modeling; Regularisation (Ridge, Lasso)."
   },
   {
    "label": "Week 7",
    "text": "Classification - K-nearest neighbours, decision trees; Generative vs discriminative models."
   },
   {
    "label": "Week 8",
    "text": "Generative models - Naive Bayes (Gaussian, decision function); Limitations."
   },
   {
    "label": "Week 9",
    "text": "Discriminative Models - perceptron (update rule and convergence); Sigmoid function; Logistic regression."
   },
   {
    "label": "Week 10",
    "text": "Maximum margin methods - SVM, soft margin; Dual formulation; Constrained optimization."
   },
   {
    "label": "Week 11",
    "text": "Soft-margin SVM - dual formulation and complementary slackness; Overfitting and underfitting; Ensemble methods - bagging and boosting."
   },
   {
    "label": "Week 12",
    "text": "Loss functions - SVM, logistic, perceptron, boosting; Neural networks; Summary."
   }
  ],
  "weeks_note": ""
 },
