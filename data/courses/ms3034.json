 "syllabus": {
  "description_paragraphs": [
   "This course covers the fundamentals of financial economics, including asset pricing, returns, present value, and capital budgeting, along with concepts such as interest rates, inflation, and risk. It also explores portfolio theory, exchange rates, derivatives and option pricing, and models like CAPM and APT, with a focus on decision-making under uncertainty and market efficiency.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Bikramaditya Datta, Department of Economic Sciences, IIT Kanpur"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Asset pricing fundamentals; Financial markets; Asset bubbles and crises; Structured finance and credit ratings."
   },
   {
    "label": "Week 2",
    "text": "Returns and time value of money; Present and future value; Net present value; Asset market applications."
   },
   {
    "label": "Week 3",
    "text": "Present value concepts; Capital budgeting rules; Time-varying rates of return."
   },
   {
    "label": "Week 4",
    "text": "Bonds and interest rates; Maturity and duration; Inflation; Yield curve analysis."
   },
   {
    "label": "Week 5",
    "text": "Credit risk and interest rates; Capital budgeting under uncertainty; Debt vs equity; Decision-making under uncertainty."
   },
   {
    "label": "Week 6",
    "text": "Decision-making under certainty and uncertainty; Risky assets and expected returns."
   },
   {
    "label": "Week 7",
    "text": "Portfolio theory fundamentals; Risk-return tradeoff; Diversification."
   },
   {
    "label": "Week 8",
    "text": "Advanced portfolio theory; Risk pooling and sharing; Portfolio optimization."
   },
   {
    "label": "Week 9",
    "text": "Exchange rates; International capital markets."
   },
   {
    "label": "Week 10",
    "text": "Financial derivatives; Options and pricing basics; Trading strategies; Put-call parity."
   },
   {
    "label": "Week 11",
    "text": "Option pricing models; Binomial model; Risk-neutral valuation; Black-Scholes formula."
   },
   {
    "label": "Week 12",
    "text": "Risk and return; CAPM; Factor models (APT); Market efficiency."
   }
  ],
  "weeks_note": ""
 },
