 "syllabus": {
  "description_paragraphs": [
   "This course introduces students to scikit-learn, a widely used Python machine learning library, providing hands-on problem solving experience with the methods and models covered in the theory course.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Ashish Tendulkar, Google Research (Visiting Asst. Professor, Department of Computer Science and Engineering, IIT Madras)"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Pandas - dataframes, selection, manipulation; Statistics."
   },
   {
    "label": "Week 2",
    "text": "Scikit-learn - data loading, preprocessing (missing data, scaling, outliers); Feature selection; PCA."
   },
   {
    "label": "Week 3",
    "text": "Pipelines and transformers; Preprocessing (imputation, scaling); Feature selection and PCA; Class imbalance; Demonstrations."
   },
   {
    "label": "Week 4",
    "text": "Regression and evaluation; Regularisation and tuning; Classification (NB, KNN, SVM, trees); Ensembles; Neural networks."
   },
   {
    "label": "Week 5",
    "text": "Regression on California housing - linear, KNN, trees; Ensembles; MLP; Baselines and demonstrations."
   },
   {
    "label": "Week 6",
    "text": "Classification - evaluation; Models (SGD, logistic, NB, KNN, SVM, trees); Ensembles; Applications (MNIST, abalone, iris)."
   },
   {
    "label": "Week 7",
    "text": "Evaluation metrics - confusion matrix, accuracy, precision, recall, F1; Multiclass; Large-scale ML."
   },
   {
    "label": "Week 8",
    "text": "Support Vector Machines using scikit-learn"
   },
   {
    "label": "Week 9",
    "text": "Clustering (K-means, HAC); Neural networks (MLP); ML workflow; Recommender systems."
   },
   {
    "label": "Week 10",
    "text": "Decision Trees, Ensemble Learning and Random Forests (Continued)"
   },
   {
    "label": "Week 11",
    "text": "Transfer learning (theory and practice); Neural networks recap."
   },
   {
    "label": "Week 12",
    "text": "Unsupervised learning"
   }
  ],
  "weeks_note": ""
 },
