 "syllabus": {
  "description_paragraphs": [
   "This course introduces the fundamentals of finance and accounting, including the lifecycle of financial transactions and applications of AI/ML in the finance industry. It also covers model explainability in regulated environments and explores real-world problems such as credit card fraud, identity fraud, and anti-money laundering.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. G Arun Kumar, Department of Management Studies, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to finance and accounting; Fundamentals of financial accounting."
   },
   {
    "label": "Week 2",
    "text": "Financial statements; Balance sheet and income statement analysis."
   },
   {
    "label": "Week 3",
    "text": "Cash flow statement; Cash flow analysis and interpretation."
   },
   {
    "label": "Week 4",
    "text": "Integrated analysis of financial statements; Linking financial reports."
   },
   {
    "label": "Week 5",
    "text": "Financial ratios; Performance evaluation and analysis."
   },
   {
    "label": "Week 6",
    "text": "Corporate finance basics; Time value of money; Financial decision-making."
   },
   {
    "label": "Week 7",
    "text": "Advanced corporate finance concepts; Investment and financing decisions."
   },
   {
    "label": "Week 8",
    "text": "Transaction lifecycle; Credit risk fundamentals; Probability of default modeling; Credit risk optimization."
   },
   {
    "label": "Week 9",
    "text": "Financial fraud detection; Supervised and unsupervised learning approaches; Practical fraud analytics."
   },
   {
    "label": "Week 10",
    "text": "Time series analysis; Components and forecasting models; Hands-on modeling."
   },
   {
    "label": "Week 11",
    "text": "Text analytics for financial forensics; Text preprocessing; Entity resolution."
   },
   {
    "label": "Week 12",
    "text": "Explainable AI (XAI); SHAP-based interpretability; AI/ML applications in financial forensics."
   }
  ],
  "weeks_note": ""
 },
