 "syllabus": {
  "description_paragraphs": [
   "The course focuses on developing greater fluency in functional and conversational English, enabling learners to understand nuanced and detailed meaning in conversations and texts through short literary pieces and contextualized content.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Rajesh Kumar, Department of Humanities and Social Sciences, IIT Madras",
   "Prof. Shreesh Chaudhary, Department of Humanities and Social Sciences, IIT Madras",
   "Prof. Om Prakash, Department of Humanities and Social Sciences, Gautham Buddha University, Noida",
   "Ms. Karthika Sathyanathan, Department of Humanities and Social Sciences, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Figures of speech; Discourse markers; Rhythm, pitch and intonation; Language use."
   },
   {
    "label": "Week 2",
    "text": "Adverbs (types and functions); Tenses and aspects; Passive structures and functions; Adjectives and degree adverbs."
   },
   {
    "label": "Week 3",
    "text": "Sentences, clauses and complex structures; Clause types (including adjectival/relative clauses); Complements and adjuncts; Illustrations and analysis."
   },
   {
    "label": "Week 4",
    "text": "Writing to argue and influence; Reflective essays; Lab-based writing."
   },
   {
    "label": "Week 5",
    "text": "Modal verbs - forms and usage (can, could, will, would, may, might, must, shall, should); Mood; Softening in language."
   },
   {
    "label": "Week 6",
    "text": "Interrogative sentences and question tags; Complex/embedded questions; Whether/if clauses; That-clauses."
   },
   {
    "label": "Week 7",
    "text": "Radio reporting; Presenting numerical information; Interview skills; Group discussions."
   },
   {
    "label": "Week 8",
    "text": "Statement of Purpose (SOP) writing; Précis writing; Lab reports; Punctuation and pauses."
   },
   {
    "label": "Week 9",
    "text": "Communication skills development; Speaking, listening, reading and writing skills; Effective writing."
   },
   {
    "label": "Week 10",
    "text": "Passive voice; Participles; Reported speech; Conditionals; Quantifiers; Negative-sensitive elements."
   },
   {
    "label": "Week 11",
    "text": "Vocabulary development; Contrast words; Connecting ideas within and between sentences; Advanced and innovative vocabulary."
   },
   {
    "label": "Week 12",
    "text": "Pragmatic competence; Professional writing - essays, reports, emails, resumes; Communication barriers and context."
   }
  ],
  "weeks_note": ""
 },
