  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Teamwork fundamentals; Importance and challenges; 10 C's of teamwork; Continuous improvement; Team roles."
   },
   {
    "label": "Week 2",
    "text": "Communication types; Communication barriers; Effective communication; 10 C's of communication."
   },
   {
    "label": "Week 3",
    "text": "Professional communication; Presentations; Report writing."
   },
   {
    "label": "Week 4",
    "text": "Leadership fundamentals; Self-leadership; Leading others."
   },
   {
    "label": "Week 5",
    "text": "Emotional intelligence; 6R framework; Conflict management; EI in practice."
   },
   {
    "label": "Week 6",
    "text": "Culture and its elements; Cross-cultural understanding; Cultural dimensions."
   },
   {
    "label": "Week 7",
    "text": "Fiscal and economic basics; Personal finance; Cash flows and compounding; Taxation; Investing and asset allocation; Financial tools and returns."
   },
   {
    "label": "Week 8",
    "text": "Creativity basics; Creative process; Tools and attitudes for creativity."
   },
   {
    "label": "Week 9",
    "text": "Growth mindset; Fixed vs growth; Handling rejection; Positive mindset; 4R framework;"
   },
   {
    "label": "Week 10",
    "text": "Systems thinking basics; Systems perspective; Developing systems thinking; Best practices."
   },
   {
    "label": "Week 11",
    "text": "Engineering mindset; Management principles; Planning and collaboration; Problem solving and abstraction."
   },
   {
    "label": "Week 12",
    "text": "Summary"
   }
  ],
  "weeks_note": ""
