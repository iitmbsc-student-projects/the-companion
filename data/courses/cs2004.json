 "syllabus": {
  "description_paragraphs": [
   "This course lays the foundation for subsequent machine learning courses by covering essential concepts that, while not strictly part of machine learning, are crucial for a comprehensive understanding of the field",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Harish G. Ramaswamy, Wadhwani School of Data Science, IIT Madras",
   "Prof. Arun Rajkumar, Wadhwani School of Data Science, IIT Madras",
   "Prof. Prashanth LA, Wadhwani School of Data Science, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to ML - data, models, tasks; Supervised (regression, classification); Unsupervised (dimensionality reduction, density estimation); Applications."
   },
   {
    "label": "Week 2",
    "text": "Sets and functions; Calculus - univariate (derivatives, applications), multivariate (lines, planes, approximations)."
   },
   {
    "label": "Week 3",
    "text": "Four fundamental subspaces; Orthogonality and orthogonal subspaces; Projections; Least squares and projections onto subspaces."
   },
   {
    "label": "Week 4",
    "text": "Linear and polynomial regression; Eigenvalues and eigenvectors; Matrix diagonalization; Orthogonal diagonalization."
   },
   {
    "label": "Week 5",
    "text": "Complex matrices; Hermitian and unitary matrices; Diagonalization."
   },
   {
    "label": "Week 6",
    "text": "SVD; Examples and applications; Positive definiteness; Geometric interpretation."
   },
   {
    "label": "Week 7",
    "text": "Principal Component Analysis - variance maximization; High-dimensional data; Applications."
   },
   {
    "label": "Week 8",
    "text": "Optimization - gradient descent; Taylor series; Multivariate methods; ML foundations."
   },
   {
    "label": "Week 9",
    "text": "Constrained Optimization and Lagrange multipliers. Projected gradient descent; Convexity - convex sets and functions; Properties of convex functions."
   },
   {
    "label": "Week 10",
    "text": "Convex optimization - properties, applications; Primal-dual problems; Karush-Kuhn-Tucker conditions; Linear programming."
   },
   {
    "label": "Week 11",
    "text": "Continuous random variables - conditional pdf, expectation; Multiple and independent variables; Transformations; Common distributions."
   },
   {
    "label": "Week 12",
    "text": "Multivariate distributions; MLE; GMM and EM; Laws of large numbers and CLT."
   }
  ],
  "weeks_note": ""
 },
