 "syllabus": {
  "description_paragraphs": [
   "This course introduces modern NLP using transformers and the Hugging Face ecosystem, covering datasets, tokenization, and fine-tuning of pre-trained models for downstream tasks. It includes advanced topics such as continual pre-training, instruction tuning, and efficient training techniques. The course also extends to multimodal applications, including speech processing (speaker identification, speech-to-text, wake word detection) and computer vision tasks such as image classification, object detection, depth estimation, and image super-resolution, with hands-on experience on real-world datasets and challenges.",
   "<b>Pre-requisite:</b> BSCS3004 : Deep Learning",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Mitesh Khapra, Wadhwani School of Data Science, IIT Madras",
   "Prof. S. Umesh, Department of Electrical Engineering, IIT Madras",
   "Prof. Kaushik Mitra, Department of Electrical Engineering, IIT Madras"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Modern NLP with transformers; Hugging Face ecosystem (datasets, tokenizers, models, trainers); Dataset loading, processing, and streaming."
   },
   {
    "label": "Week 2",
    "text": "Tokenization techniques; Tokenizer pipeline (normalization, pre-tokenization, encoding/decoding); Training custom tokenizers."
   },
   {
    "label": "Week 3",
    "text": "Fine-tuning transformer models; Task-specific adaptation; Parameter-efficient vs full fine-tuning; Evaluation metrics."
   },
   {
    "label": "Week 4",
    "text": "Pre-training and instruction tuning; CLM/MLM objectives; Efficient training (mixed precision, checkpointing); PEFT methods (LoRA, QLoRA)."
   },
   {
    "label": "Week 5",
    "text": "Spoken language identification; Audio-based classification tasks."
   },
   {
    "label": "Week 6",
    "text": "Speaker diarization; Identifying speakers and segmentation in conversations."
   },
   {
    "label": "Week 7",
    "text": "Speech processing; Speech-to-text (ASR) and text-to-speech (TTS) systems."
   },
   {
    "label": "Week 8",
    "text": "Wake-word detection; Personalized keyword spotting systems."
   },
   {
    "label": "Week 9",
    "text": "Image classification; CNN architectures (AlexNet, VGG, ResNet, DenseNet, ViT); Dataset challenges (variation, imbalance)."
   },
   {
    "label": "Week 10",
    "text": "Object detection; Models (YOLO, R-CNN); Handling real-world datasets and class imbalance."
   },
   {
    "label": "Week 11",
    "text": "Depth estimation from images; Models (U-Net, Pix2Pix); Challenges like low-light conditions."
   },
   {
    "label": "Week 12",
    "text": "Image super-resolution; GAN-based methods (SRGAN); Applications to medical imaging."
   }
  ],
  "weeks_note": ""
 },
