 "syllabus": {
  "description_paragraphs": [
   "This course provides a strong foundation in the basic concepts of algorithm design and analysis, along with standard data structures, using Python as the primary implementation language.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Madhavan Mukund, Director, Chennai Mathematical Institute"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Python recap; Jupyter/Colab; Exception handling; OOP; Code implementation and efficiency."
   },
   {
    "label": "Week 2",
    "text": "Algorithm analysis; Complexity; Searching and sorting (selection, insertion, merge); Implementation."
   },
   {
    "label": "Week 3",
    "text": "Quicksort - analysis and implementation; Comparison of sorting algorithms; Lists vs arrays; Implementation of lists and dictionaries; Stack and queue."
   },
   {
    "label": "Week 4",
    "text": "Graphs and representations; Breadth-first and depth-first search; Applications of BFS and DFS; Directed acyclic graphs; Topological sorting; Longest path."
   },
   {
    "label": "Week 5",
    "text": "Shortest paths (Dijkstra, Bellman-Ford, Floyd-Warshall); Minimum spanning trees (Prim's, Kruskal's)."
   },
   {
    "label": "Week 6",
    "text": "Union-Find data structure; Priority queues and heaps; Heaps in algorithms; Search trees."
   },
   {
    "label": "Week 7",
    "text": "Balanced search trees; Greedy algorithms - interval scheduling, minimizing lateness, Huffman coding."
   },
   {
    "label": "Week 8",
    "text": "Divide and conquer - counting inversions, closest pair of points, integer multiplication; Recursion trees; Selection algorithms."
   },
   {
    "label": "Week 9",
    "text": "Dynamic programming - memoization; Applications - grid paths, subsequences, edit distance, matrix multiplication."
   },
   {
    "label": "Week 10",
    "text": "String matching algorithms - Boyer-Moore, Rabin-Karp, and KMP algorithm; Automata-based string matching; Regular expressions."
   },
   {
    "label": "Week 11",
    "text": "Linear programming and applications; Network flows; Reductions; Intractability (P vs NP)."
   },
   {
    "label": "Week 12",
    "text": "Course Summary."
   }
  ],
  "weeks_note": ""
 },
