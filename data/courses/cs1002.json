 "syllabus": {
  "description_paragraphs": [
   "This course serves as the first formal introduction to programming in the programme. It introduces Python - used throughout the curriculum - while developing foundational problem-solving and algorithmic skills.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Prof. Sudarshan Iyengar, Department of Computer Science and Engineering, IIT Ropar"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Programming basics - Replit, variables, data types, operators, strings; Common errors."
   },
   {
    "label": "Week 2",
    "text": "Variables and dynamic typing; Operators and expressions; Strings (methods, escape characters, applications); Conditional statements (if, else, elif); Importing libraries."
   },
   {
    "label": "Week 3",
    "text": "Iteration - while, for, nested loops; Range; Loop control (break, continue, pass); Formatted output; Applications."
   },
   {
    "label": "Week 4",
    "text": "Lists, sets and tuples; List comprehensions; Introduction to functions; Function types and arguments."
   },
   {
    "label": "Week 5",
    "text": "Dictionaries; Functions and scope; Iterators and generators; Functional tools; Applications (sorting, matrix multiplication)."
   },
   {
    "label": "Week 6",
    "text": "Practice Problems I"
   },
   {
    "label": "Week 7",
    "text": "Practice Problems II"
   },
   {
    "label": "Week 8",
    "text": "File handling - reading and writing; Handling large files; Applications (Caesar cipher, genetic sequences)."
   },
   {
    "label": "Week 9",
    "text": "Recursion - concepts and applications; Recursive problem solving (searching, sorting); Binary search (iterative and recursive)."
   },
   {
    "label": "Week 10",
    "text": "Exception handling; Introduction to object oriented programming; Classes and objects; Attributes and methods; Inheritance and method overriding."
   },
   {
    "label": "Week 11",
    "text": "Numerical and data libraries - NumPy, Pandas (Series, DataFrames); Data visualization with Matplotlib."
   },
   {
    "label": "Week 12",
    "text": "Course Summary"
   }
  ],
  "weeks_note": ""
 },
