 "syllabus": {
  "description_paragraphs": [
   "This course provides a foundational understanding of research methodology and its application across business domains, with a focus on marketing research. It covers the role, scope, process, cost, and value of research, aligns techniques with business problems, and develops skills in data analysis and translating insights into actionable outcomes through hands-on projects.",
   "<b>Lectures-Tutorials-Practicals-Credits:</b> 4-0-0-4"
  ],
  "faculty": [
   "Mr. Ashok Sankethi, CEO, Kaybase Research"
  ],
  "faculty_note": "",
  "weeks_text": [
   {
    "label": "Week 1",
    "text": "Introduction to market research; Industry overview; Research process; Sampling methods and sample size determination."
   },
   {
    "label": "Week 2",
    "text": "Basic statistics for market research; Key terms and concepts."
   },
   {
    "label": "Week 3",
    "text": "Questionnaire design; Survey structuring and best practices."
   },
   {
    "label": "Week 4",
    "text": "Qualitative research methods; Interviews and discussion guides; Data collection techniques."
   },
   {
    "label": "Week 5",
    "text": "Applied market research; Brand health assessment; Customer satisfaction measurement."
   },
   {
    "label": "Week 6",
    "text": "Advertising research; Ad pre-testing; Questionnaire design for campaigns."
   },
   {
    "label": "Week 7",
    "text": "Employee satisfaction studies; Concept testing methods."
   },
   {
    "label": "Week 8",
    "text": "Product testing; Channel satisfaction analysis."
   },
   {
    "label": "Week 9",
    "text": "Brand research applications; Corporate and celebrity brand evaluation."
   },
   {
    "label": "Week 10",
    "text": "Consumer profiling and segmentation; Consumer decision journey (CDJ)."
   },
   {
    "label": "Week 11",
    "text": "CDJ case studies; Market intelligence sources (India context)."
   },
   {
    "label": "Week 12",
    "text": "Data analysis in market research; Interpretation and reporting."
   }
  ],
  "weeks_note": ""
 },
