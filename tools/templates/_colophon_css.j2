  /* ---- page footer ---- */
  footer.colophon{margin-top:40px;border-top:1px solid var(--rule);background:var(--paper-2);font-family:'IBM Plex Sans',sans-serif;font-style:normal}
  footer.colophon .co-in{max-width:900px;margin:0 auto;padding:20px 28px 20px}
  footer.colophon .co-note{display:flex;align-items:flex-start;gap:12px;margin:0 0 20px;padding:12px 16px;
    border:1px solid var(--rule);border-left:3px solid var(--accent-2);border-radius:6px;background:var(--paper);
    font-size:13.5px;line-height:1.55;color:var(--ink-2)}
  footer.colophon .co-i{flex:none;display:grid;place-items:center;width:20px;height:20px;margin-top:1px;border-radius:50%;
    background:var(--tint-2);color:var(--accent);font:italic 700 12px/1 'Spectral',serif}
  footer.colophon .co-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 24px}
  footer.colophon .co-brand{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 12px}
  footer.colophon .co-by{font-size:12.5px;color:var(--ink-2);white-space:nowrap}
  footer.colophon .co-name{font-family:'Spectral',serif;font-weight:600;font-size:15px;color:var(--ink)}
  footer.colophon .co-nav{display:flex;flex-wrap:wrap;gap:0 20px;font-family:'IBM Plex Mono',monospace;font-size:11px;
    letter-spacing:.12em;text-transform:uppercase}
  footer.colophon .co-nav a{display:inline-block;padding:7px 0;color:var(--ink-2);border:none}
  footer.colophon .theme-foot{margin-top:14px}
  footer.colophon .co-nav a:hover{color:var(--accent)}
  footer.colophon .co-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 16px;flex:1 1 100%;letter-spacing:.08em}
  footer.colophon .co-nav a{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  footer.colophon .co-row .co-brand{flex:1 1 auto}
  footer.colophon .se-views{font:400 12px 'IBM Plex Sans',sans-serif;letter-spacing:0;text-transform:none;color:var(--ink-2);padding-left:12px;border-left:1px solid var(--rule)}
  @media(max-width:720px){footer.colophon .co-nav{grid-template-columns:repeat(2,minmax(0,1fr))}}
