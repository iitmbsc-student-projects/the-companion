  /* ---- page footer ---- */
  footer.colophon{margin-top:40px;border-top:1px solid var(--rule);background:var(--paper-2);font-family:'Inter',sans-serif;font-style:normal}
  footer.colophon .co-in{max-width:900px;margin:0 auto;padding:22px 28px 30px}
  footer.colophon .co-note{display:flex;align-items:flex-start;gap:12px;margin:0 0 20px;padding:12px 16px;
    border:1px solid var(--rule);border-left:3px solid var(--accent-2);border-radius:6px;background:var(--paper);
    font-size:13.5px;line-height:1.55;color:var(--ink-2)}
  footer.colophon .co-i{flex:none;display:grid;place-items:center;width:20px;height:20px;margin-top:1px;border-radius:50%;
    background:var(--tint-2);color:var(--accent);font:italic 700 12px/1 'Fraunces',serif}
  footer.colophon .co-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 24px}
  footer.colophon .co-name{font-family:'Fraunces',serif;font-weight:600;font-size:15px;color:var(--ink)}
  footer.colophon .co-nav{display:flex;flex-wrap:wrap;gap:6px 20px;font-family:'JetBrains Mono',monospace;font-size:11px;
    letter-spacing:.12em;text-transform:uppercase}
  footer.colophon .co-nav a{color:var(--ink-2);border:none}
  footer.colophon .co-nav a:hover{color:var(--accent)}
