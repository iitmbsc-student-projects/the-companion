  /* resources: small cards of one size in a tidy grid. Long descriptions stop at two lines
     (the full text is in the tooltip and is still read by screen readers), so rows stay even. */
  .res-group{margin-top:22px}
  .res-group:first-of-type{margin-top:6px}
  .res-group-title{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-family:'IBM Plex Mono',monospace;
    font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
  .res-group-title::after{content:"";flex:1;border-bottom:1px solid var(--rule)}
  .res-count{order:2;color:var(--accent);background:var(--tint);border-radius:999px;padding:0 8px;letter-spacing:.04em}
  .res-grid{list-style:none;margin:0;padding:0;display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(205px,1fr))}
  .res-card{position:relative;display:flex;flex-direction:column;gap:2px;min-width:0;padding:8px 12px 8px;background:var(--paper-2);
    border:1px solid var(--rule);border-left:3px solid var(--rule);border-radius:3px;
    transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}
  .res-card:hover{border-left-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 16px var(--shadow)}
  .res-card:has(.res-main)::after{content:"\2197";position:absolute;top:7px;right:9px;font-size:12px;color:var(--accent-2)}
  .res-main{font-family:'Spectral',serif;font-weight:600;font-size:15px;line-height:1.3;color:var(--ink);border:none;padding-right:14px;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
  .res-main::after{content:"";position:absolute;inset:0}
  .res-main:hover{color:var(--accent)}
  .res-main:focus-visible{outline:none}
  .res-card:has(.res-main:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
  .res-desc{margin:0;color:var(--ink-2);font-size:13px;line-height:1.4;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1;overflow:hidden}
  .res-foot{display:flex;flex-wrap:nowrap;align-items:center;gap:8px;margin-top:auto;padding-top:3px;min-width:0}
  .res-host{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-2);letter-spacing:.02em;
    max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .res-by{color:var(--ink-2);font-size:12px;font-style:italic;min-width:0}
  .res-foot .res-by{position:relative;z-index:1;max-width:100%;padding-right:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .res-badge{flex:none;margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.04em;text-transform:uppercase;padding:0 6px;
    border-radius:999px;border:1px solid var(--warn-line);color:var(--warn-ink);background:var(--warn-bg)}
  .res-badge.iitm{border-color:var(--accent-line);color:var(--accent);background:var(--tint)}
  @media(max-width:640px){ .res-grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))} }
