  .res-by{color:var(--ink-2);font-size:13px;font-style:italic}
  .res-group{margin-top:22px}
  .res-group:first-of-type{margin-top:6px}
  .res-group-title{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-family:'JetBrains Mono',monospace;
    font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2)}
  .res-group-title::after{content:"";flex:1;border-bottom:1px solid var(--rule)}
  .res-count{order:2;color:var(--accent);background:var(--tint);border-radius:999px;padding:0 8px;letter-spacing:.04em}
  .res-grid{list-style:none;margin:0;padding:0;display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  .res-card{position:relative;display:flex;flex-direction:column;gap:6px;padding:13px 16px 12px;background:var(--paper-2);
    border:1px solid var(--rule);border-left:3px solid var(--rule);border-radius:3px;
    transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}
  .res-card:hover{border-left-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 16px var(--shadow)}
  .res-card:has(.res-main)::after{content:"\2197";position:absolute;top:11px;right:14px;font-size:14px;color:var(--accent-2);opacity:.7}
  .res-main{font-family:'Fraunces',serif;font-weight:600;font-size:16.5px;line-height:1.3;color:var(--ink);border:none;padding-right:18px}
  .res-main::after{content:"";position:absolute;inset:0}
  .res-main:hover{color:var(--accent)}
  .res-desc{margin:0;color:var(--ink-2);font-size:14px;line-height:1.5}
  .res-foot{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;margin-top:auto;padding-top:2px}
  .res-host{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-2);letter-spacing:.02em;word-break:break-all}
  .res-foot .res-by{position:relative;z-index:1;font-size:12.5px}
  .res-badge{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;
    border-radius:999px;border:1px solid var(--warn-line);color:var(--warn-ink);background:var(--warn-bg)}
  .res-badge.iitm{border-color:var(--accent-line);color:var(--accent);background:var(--tint)}
  @media(max-width:640px){ .res-grid{grid-template-columns:1fr} }
